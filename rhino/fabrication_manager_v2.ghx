              <chunks count="1">
                <chunk name="Container">
                  <items count="12">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import time
from fabrication_manager.task import Task

class Task1(Task):
    def run(self, _stop_flag):
        # do something
        self.log("This is task 1")
        finished = True
        if finished:
            self.is_completed = True

class Task2(Task):
    def run(self, _stop_flag):
        # do something
        self.log("Task 2 counting up")
        for i in range(10):
            self.log("Counting: {}".format(i))
        finished = True
        if finished:
            self.is_completed = True

class Task3(Task):
    def run(self, _stop_flag):
        # do something
        self.log("Task 3 starting...")
        current_time = time.time()
        while time.time()&lt;(current_time+1):
            self.log("waiting...")
        else:
            self.log("done waiting!")
        finished = True
        if finished:
            self.is_completed = True

if create:
    task1 = Task1()
    task1.parallelizable = True
    task2 = Task2()
    task2.parallelizable = True
    task3 = Task3()
    task3.parallelizable = True

tasks = [task1, task2, task3]
